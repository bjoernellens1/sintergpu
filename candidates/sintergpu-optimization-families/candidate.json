  "contracts": {
    "point_plane": "FP32 left infinitesimal action; rotation-first cross(p,n),n Jacobian; AoSoA z-x-y versus scalar z-y-x explicit FMA accumulation; no filtering/clamping/weighting; indexed gathers and padded4+2 AoSoA adapters; NaN/Inf/signed-zero/overflow kept",
    "cholesky": "row-major lower H then b; solve (H+damping I)x=-b; original i/j/k order; capacity6 fixed6 or capacity18 runtime6/12/18; prevalidated core returns validity, adapter emits zero failure; checked wrapper rejects bad dimensions/clears output; observation policy retained outside core",
    "fused": "all original residual/Jacobian/partials/final terms/delta/status exported; unchanged higher reductions and incumbent solve; exact workgroup and subgroup+workgroup profiles retained",
    "capacity": "caller validates uint32 index products, dimensions, indices, buffers and dispatch/device limits; tested counts1/63/64/65/1023/1024/1025/4099/65539 across applicable profiles",
    "gradients": "independent finite-difference symbolic Jacobian plus independent GPU analytic parity; no backward/differentiable-solver claim",
    "ordering_overflow": "no sorting, append, truncation or new wrapping policy; exact original tree and loop ordering"
  },
