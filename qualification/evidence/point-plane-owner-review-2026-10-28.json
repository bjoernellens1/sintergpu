    "reproducer_source": "from pathlib import Path\nimport sys,json,gzip,hashlib\nroot=Path('/home/bjoern/.codex/worktrees/kernel-families-candidates/sintergpu/candidates/sintergpu-optimization-families')\nsys.path.insert(0,str(root/'benchmarks'))\nfrom family_timings import compare\nout=[]\nfor iteration,device in [('iteration7','native-radeon'),('iteration6','native-rtx4070')]:\n directory=root/'evidence'/iteration/device\n plan=json.loads((directory/'suite-plan.json').read_text())\n report=json.loads((directory.with_name(device+'-report.json')).read_text())['devices'][0]\n control=json.loads((directory/'collection-control.json').read_text())\n assert control['cooperating_collectors_excluded']\n for result in plan['results']:\n  if (result['profile'],result['count'])!=('aosoa',1025):continue\n  assert result['output'] not in control.get('ineligible_outputs',{})\n  path=directory/result['output']\n  data=path.read_bytes() if path.exists() else gzip.decompress(path.with_suffix('.json.gz').read_bytes())\n  assert hashlib.sha256(data).hexdigest()==result['sha256']\n  raw=json.loads(data)\n  expected=next(r for r in report['results'] if (r['profile'],r['count'],r['run'])==('aosoa',1025,result['run']))\n  assert expected['all_boundaries_pass']\n  for boundary in ('gpu_timestamp','resident_completion','transfer_inclusive'):\n   samples=[s for s in raw['samples'] if s['boundary']==boundary]\n   assert len(samples)==40000\n   key='gpu_ns' if boundary=='gpu_timestamp' else 'wall_ns'\n   blocks=[[s[key]/1e6 for s in samples[i:i+4]] for i in range(0,len(samples),4)]\n   actual=compare(blocks)\n   assert actual['decision']!='retain-baseline'\n   assert all(actual[k]==v for k,v in expected['boundaries'][boundary].items() if k!='thread_cpu_ms'),(iteration,result['run'],boundary)\n   out.append(dict(iteration=iteration,device=device,run=result['run'],boundary=boundary,acceptance=actual))\n   print(iteration,device,result['run'],boundary,'exact report recomputation PASS',flush=True)\nassert len(out)==18\nPath('/home/bjoern/.codex/worktrees/kernel-consolidation/sintergpu/build/candidate-native-owner-statistics.json').write_text(json.dumps(out,indent=2)+'\\n')\n",
    "scope": "Exact reproduction using reviewed candidate family_timings.compare on each retained10000-block raw record. This independently reruns computation, not an independent statistical methodology."
