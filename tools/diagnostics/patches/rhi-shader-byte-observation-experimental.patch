+// Experimental diagnostic interface, not a dispatch/pipeline identity proof.
+// Query through IShaderProgram. Retain the returned interface, and serialize
+// access with compilation, reload, close and destruction. Byte pointers are
+// borrowed until release; copy immediately. Only successful Vulkan module
+// creations are observable. This interface adds no GPU submission or wait.
+class IVulkanShaderBytesObservationV1 : public ISlangUnknown
+{
+    SLANG_COM_INTERFACE(0xc9b6db16, 0x4ac0, 0x45a1, {0xa6, 0x90, 0x6d, 0x02, 0xab, 0x14, 0x2e, 0x39});
+public:
+    virtual SLANG_NO_THROW Result SLANG_MCALL getModuleCount(uint32_t* outCount) = 0;
+    virtual SLANG_NO_THROW Result SLANG_MCALL getModule(uint32_t index, const void** outBytes,
+        size_t* outSize, const char** outEntryName, uint64_t* outShaderModule) = 0;
+};
