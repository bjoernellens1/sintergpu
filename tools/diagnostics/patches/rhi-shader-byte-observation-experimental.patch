+Result ShaderProgramImpl::queryInterface(const SlangUUID& uuid, void** outObject)
+{
+    if (!outObject) return SLANG_FAIL;
+    *outObject = nullptr;
+    if (uuid == IVulkanShaderBytesObservationV1::getTypeGuid())
+    {
+        *outObject = static_cast<IVulkanShaderBytesObservationV1*>(this);
+        ShaderProgram::addRef();
+        return SLANG_OK;
+    }
+    return ShaderProgram::queryInterface(uuid, outObject);
+}
+
+Result ShaderProgramImpl::getModuleCount(uint32_t* outCount)
+{
+    if (!outCount || !m_compiledShaders || m_modules.empty() || m_modules.size() > UINT32_MAX) return SLANG_E_NOT_AVAILABLE;
+    for (auto& module : m_modules)
+        if (!module.observedCreationSucceeded) return SLANG_E_NOT_AVAILABLE;
+    *outCount = uint32_t(m_modules.size());
+    return SLANG_OK;
+}
+
+Result ShaderProgramImpl::getModule(uint32_t index, const void** outBytes, size_t* outSize,
+                                    const char** outEntryName, uint64_t* outShaderModule)
+{
+    uint32_t count = 0;
+    if (!outBytes || !outSize || !outEntryName || !outShaderModule ||
+        SLANG_FAILED(getModuleCount(&count)) || index >= count) return SLANG_E_NOT_AVAILABLE;
+    auto& module = m_modules[index];
+    if (module.observedCode.empty() || !module.shaderModule) return SLANG_E_NOT_AVAILABLE;
+    *outBytes = module.observedCode.data();
+    *outSize = module.observedCode.size() * sizeof(uint32_t);
+    *outEntryName = module.entryPointName.c_str();
+    *outShaderModule = uint64_t(module.shaderModule);
+    return SLANG_OK;
+}
