+// SinterGPU experimental controlled-process diagnostic interface.
+// Query through IBuffer::queryInterface; never cast to backend-private objects.
+// A successful query retains its buffer owner until release. Callers serialize
+// queries against device close and resource release. Observations cover only
+// backend calls in a controlled process; foreign native operations are outside
+// the contract. A snapshot is historical after the interface is released.
+struct VulkanBufferAllocationObservationV1
+{
+    uint32_t structSize = sizeof(VulkanBufferAllocationObservationV1);
+    uint32_t schemaVersion = 1;
+    uint64_t ownerGeneration = 0;
+    uint64_t buffer = 0;
+    uint64_t memory = 0;
+    uint64_t bindingOffset = 0;
+    uint64_t bufferSize = 0;
+    uint64_t allocationSize = 0;
+};
+
+class IVulkanBufferAllocationObservationV1 : public ISlangUnknown
+{
+    SLANG_COM_INTERFACE(0x528c5036, 0x73c5, 0x4de9, {0x91, 0x2c, 0xcd, 0x71, 0x35, 0x44, 0x49, 0x0f});
+public:
+    // Must fail for shared, external, sparse, imported, wrapped, rebound,
+    // untracked or released objects; no allocation or GPU operations. An RHI
+    // query can outlive SGL logical close; it does not represent SGL liveness.
+    virtual SLANG_NO_THROW Result SLANG_MCALL getObservation(
+        VulkanBufferAllocationObservationV1* outObservation) = 0;
+};
