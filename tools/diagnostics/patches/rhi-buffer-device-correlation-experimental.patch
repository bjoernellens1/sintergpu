+Result BufferImpl::getDeviceCorrelation(VulkanBufferDeviceCorrelationV1* out)
+{
+    if (!out || out->structSize != sizeof(*out) || out->schemaVersion != 1)
+        return SLANG_E_NOT_AVAILABLE;
+    VulkanBufferDeviceCorrelationV1 value{};
+    if (SLANG_FAILED(getObservation(&value.allocation))) return SLANG_E_NOT_AVAILABLE;
+    auto* device = getDevice<DeviceImpl>();
+    if (!device || !device->getObservedDeviceIdentity(value.deviceGeneration, value.device))
+        return SLANG_E_NOT_AVAILABLE;
+    *out = value;
+    return SLANG_OK;
+}
