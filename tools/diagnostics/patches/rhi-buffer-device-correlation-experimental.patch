+// Experimental controlled-process correlation. Copy is not a lifetime lease.
+struct VulkanBufferDeviceCorrelationV1
+{
+    uint32_t structSize = sizeof(VulkanBufferDeviceCorrelationV1);
+    uint32_t schemaVersion = 1;
+    VulkanBufferAllocationObservationV1 allocation;
+    uint64_t deviceGeneration = 0;
+    uint64_t device = 0; // typed VkDevice, compared to creation receipt
+};
+class IVulkanBufferDeviceCorrelationV1 : public ISlangUnknown
+{
+    SLANG_COM_INTERFACE(0xe5f813bd, 0xa3c1, 0x4acb, {0xa9, 0x4c, 0x86, 0x59, 0xf5, 0x74, 0x6f, 0x31});
+public:
+    virtual SLANG_NO_THROW Result SLANG_MCALL getDeviceCorrelation(VulkanBufferDeviceCorrelationV1* out) = 0;
+};
