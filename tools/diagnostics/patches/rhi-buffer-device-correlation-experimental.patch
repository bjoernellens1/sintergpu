+    // Snapshot is valid only while caller serializes all backend lifecycle operations.
+    bool getObservedDeviceIdentity(uint64_t& generation, uint64_t& handle) const
+    {
+        const auto& r = m_creationReceipt;
+        if (!r.finalized || !r.ownerGeneration || !r.deviceUUIDKnown || r.instanceExternal ||
+            r.physicalDeviceExternal || r.deviceExternal || r.device.type != NativeHandleType::VkDevice ||
+            !r.device.value || r.device.value != uint64_t(m_device)) return false;
+        bool uuidNonzero = false;
+        for (auto byte : r.deviceUUID) uuidNonzero |= byte != 0;
+        if (!uuidNonzero) return false;
+        generation = r.ownerGeneration;
+        handle = r.device.value;
+        return true;
+    }
