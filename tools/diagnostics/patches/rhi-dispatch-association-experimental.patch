+bool appendDirectDispatchObservation(CommandBufferImpl* command, ComputePipelineImpl* pipeline, uint32_t x, uint32_t y, uint32_t z)
+{
+    if (!command || !pipeline || !pipeline->m_pipeline || !pipeline->m_dispatchObservationReady ||
+        !pipeline->m_dispatchObservationModule || pipeline->m_dispatchObservationCode.empty()) return false;
+    CommandBufferImpl::DispatchObservation item;
+    item.pipeline = uint64_t(pipeline->m_pipeline);
+    item.shaderModule = uint64_t(pipeline->m_dispatchObservationModule);
+    item.groups[0] = x; item.groups[1] = y; item.groups[2] = z;
+    item.code = pipeline->m_dispatchObservationCode;
+    command->m_dispatchObservations.push_back(std::move(item));
+    return true;
+}
+
 void CommandRecorder::cmdDispatchCompute(const commands::DispatchCompute& cmd)
 {
     if (!m_computeStateValid)
         return;
 
+    if (!appendDirectDispatchObservation(m_observedCommandBuffer, m_computePipeline.get(), cmd.x, cmd.y, cmd.z))
+        m_observedCommandBuffer->m_observationEligible = false;
     m_api.vkCmdDispatch(m_cmdBuffer, cmd.x, cmd.y, cmd.z);
 }
 
