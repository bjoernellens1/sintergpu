+Result CommandBufferImpl::queryInterface(const SlangUUID& uuid, void** outObject)
+{
+    if (!outObject) return SLANG_FAIL;
+    *outObject = nullptr;
+    if (uuid == IVulkanRecordedDispatchObservationV1::getTypeGuid())
+    {
+        *outObject = static_cast<IVulkanRecordedDispatchObservationV1*>(this);
+        CommandBuffer::addRef();
+        return SLANG_OK;
+    }
+    return CommandBuffer::queryInterface(uuid, outObject);
+}
+Result CommandBufferImpl::getDispatchCount(uint32_t* outCount)
+{
+    if (!outCount || !m_observationReady || !m_observationEligible || !m_observationGeneration ||
+        m_dispatchObservations.empty() || m_dispatchObservations.size() > UINT32_MAX) return SLANG_E_NOT_AVAILABLE;
+    *outCount = uint32_t(m_dispatchObservations.size());
+    return SLANG_OK;
+}
+Result CommandBufferImpl::getDispatch(uint32_t index, VulkanRecordedDispatchV1* out)
+{
+    uint32_t count = 0;
+    if (!out || out->structSize != sizeof(*out) || out->schemaVersion != 1 ||
+        SLANG_FAILED(getDispatchCount(&count)) || index >= count || !m_commandBuffer) return SLANG_E_NOT_AVAILABLE;
+    const auto& item = m_dispatchObservations[index];
+    if (!item.pipeline || !item.shaderModule || item.code.empty()) return SLANG_E_NOT_AVAILABLE;
+    VulkanRecordedDispatchV1 value{};
+    value.recordingGeneration = m_observationGeneration;
+    value.commandBuffer = uint64_t(m_commandBuffer);
+    value.pipeline = item.pipeline; value.shaderModule = item.shaderModule;
+    for (unsigned i = 0; i < 3; ++i) value.groups[i] = item.groups[i];
+    value.code = item.code.data(); value.codeSize = item.code.size()*sizeof(uint32_t);
+    *out = value;
+    return SLANG_OK;
+}
