+// Diagnostic record-time observation only; does not prove submission or execution.
+// Query while the originating command buffer is alive and serialize with reset,
+// pool reuse, submit and close. Returned byte pointers are borrowed until release.
+struct VulkanRecordedDispatchV1
+{
+    uint32_t structSize = sizeof(VulkanRecordedDispatchV1);
+    uint32_t schemaVersion = 1;
+    uint64_t recordingGeneration = 0;
+    uint64_t commandBuffer = 0;
+    uint64_t pipeline = 0;
+    uint64_t shaderModule = 0;
+    uint32_t groups[3] = {};
+    const void* code = nullptr;
+    size_t codeSize = 0;
+};
+class IVulkanRecordedDispatchObservationV1 : public ISlangUnknown
+{
+    SLANG_COM_INTERFACE(0x7d01de37, 0x1599, 0x43db, {0x93, 0x9e, 0x9b, 0x59, 0x14, 0xec, 0x64, 0x23});
+public:
+    virtual SLANG_NO_THROW Result SLANG_MCALL getDispatchCount(uint32_t* outCount) = 0;
+    virtual SLANG_NO_THROW Result SLANG_MCALL getDispatch(uint32_t index, VulkanRecordedDispatchV1* out) = 0;
+};
