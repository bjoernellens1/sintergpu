@PACKAGE_INIT@
# find_dependency may change PACKAGE_PREFIX_DIR before CMake 3.30. Retain our
# prefix while resolving caller-owned dependencies from other installations.
set(_sintergpu_package_prefix "${PACKAGE_PREFIX_DIR}")
if(@SINTERGPU_BUILD_RADIX@)
    include(CMakeFindDependencyMacro)
    find_dependency(Vulkan)
    if(NOT TARGET volk AND NOT TARGET volk::volk)
        find_dependency(volk CONFIG)
    endif()
    if(TARGET volk::volk)
        set(_sintergpu_volk volk::volk)
    elseif(TARGET volk)
        set(_sintergpu_volk volk)
    else()
        set(sintergpu_FOUND FALSE)
        set(sintergpu_NOT_FOUND_MESSAGE "Native radix requires a volk or volk::volk target")
        return()
    endif()
    if(NOT TARGET sintergpu::radix_volk)
        add_library(sintergpu::radix_volk INTERFACE IMPORTED)
        set_target_properties(sintergpu::radix_volk PROPERTIES
            INTERFACE_LINK_LIBRARIES "${_sintergpu_volk}")
    endif()
    unset(_sintergpu_volk)
endif()
set(PACKAGE_PREFIX_DIR "${_sintergpu_package_prefix}")
unset(_sintergpu_package_prefix)
include("${CMAKE_CURRENT_LIST_DIR}/sintergpuTargets.cmake")
set_and_check(SINTERGPU_KERNEL_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/sintergpu/kernels")
set_and_check(SINTERGPU_DATA_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/sintergpu/data")
check_required_components(sintergpu)
